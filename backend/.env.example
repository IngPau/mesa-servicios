# Copia este archivo como ".env" y llena tus valores. NUNCA subas el .env al repositorio.
PORT=3000

# Connection string de Atlas, con la contraseña real y el nombre de la base (mesa_servicios)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/mesa_servicios?retryWrites=true&w=majority

# Frase larga cualquiera; todo el equipo puede usar la misma
JWT_SECRET=cambia_esto_por_una_frase_larga_y_secreta
JWT_EXPIRES_IN=8h

# Dirección del frontend (React con Vite usa 5173)
CORS_ORIGIN=http://localhost:5173
