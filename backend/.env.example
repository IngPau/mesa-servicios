# Copia este archivo como ".env" (copy .env.example .env). El .env NO se sube al repositorio.
# En Railway estas mismas variables se ponen en la pestaña "Variables" del servicio.

# Connection string de MongoDB Atlas (con la contraseña real y el nombre de la base /mesa_servicios)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/mesa_servicios?retryWrites=true&w=majority

# Texto largo y aleatorio para firmar los tokens
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Dirección(es) del frontend que pueden llamar a la API, separadas por coma.
# Local: http://localhost:5173   |   Producción: https://TU-FRONTEND.up.railway.app
CORS_ORIGIN=http://localhost:5173

# Railway asigna PORT automáticamente; en local se usa 3000
PORT=3000
